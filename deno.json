{
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-read --env-file=.env --watch src/index.ts",
    "build": "deno check main.ts src/index.ts prisma.config.ts",
    "test": "deno test --allow-ffi --allow-read --allow-env main_test.ts src/",
    "test:integration": "deno test --allow-ffi --allow-read --allow-env --allow-net --env-file=.env tests/",
    "contract:emit": "deno run -A --env-file=.env npm:prisma@8.0.0-rc.33 contract emit",
    "db:init": "deno run -A --env-file=.env npm:prisma@8.0.0-rc.33 db init",
    "db:update": "deno run -A --env-file=.env npm:prisma@8.0.0-rc.33 db update",
    "db:verify": "deno run -A --env-file=.env npm:prisma@8.0.0-rc.33 db verify",
    "migrate": "deno run -A --env-file=.env npm:prisma@8.0.0-rc.33 db migrate",
    "migration:plan": "deno run -A --env-file=.env npm:prisma@8.0.0-rc.33 migration plan",
    "migration:show": "deno run -A --env-file=.env npm:prisma@8.0.0-rc.33 migration show",
    "migration:status": "deno run -A --env-file=.env npm:prisma@8.0.0-rc.33 migration status",
    "start": "deno run --allow-net --allow-env --allow-read --env-file=.env src/index.ts"
  },
  "imports": {
    "@hegeldev/hegel": "npm:@hegeldev/hegel@0.6.2",
    "@hegeldev/hegel/generators": "npm:@hegeldev/hegel@0.6.2/generators",
    "@prisma/orm-postgres": "npm:@prisma/orm-postgres@8.0.0-rc.23",
    "prisma": "npm:prisma@8.0.0-rc.33"
  },
  "nodeModulesDir": "auto",
  "allowScripts": {
    "allow": [],
    "deny": ["npm:esbuild@0.28.2", "npm:koffi@3.3.8"]
  }
}
